# Django Settings
DJANGO_SECRET_KEY=django-insecure-prod-key-change-this-in-production-ims-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL primary, fallback SQLite if DB not configured)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=inventory_db
DB_USER=inventory_user
DB_PASSWORD=replace-with-a-local-database-password
DB_HOST=localhost
DB_PORT=5432

# CORS & Frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
